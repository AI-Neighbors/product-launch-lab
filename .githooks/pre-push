#!/usr/bin/env bash
set -euo pipefail

blocked=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/rehearsal/*)
      if [[ "${EVENT_ADMIN_PUSH:-0}" != "1" ]]; then
        echo "BLOCKED: direct push to protected event branch ${remote_ref#refs/heads/}. Open a PR." >&2
        blocked=1
      fi
      ;;
  esac
done

exit "$blocked"
